{
  "name": "aquabuddy-water-reminder",
  "version": "1.0.0",
  "description": "Cross-platform desktop water reminder app for Mac & Windows with an animated walking mascot character and interactive water tracker.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "package-extension": "node scripts/package_extension.js"
  },
  "build": {
    "appId": "com.aquabuddy.waterreminder",
    "productName": "AquaBuddy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "icons/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [
    "water-reminder",
    "hydration",
    "desktop-mascot",
    "electron",
    "cross-platform",
    "macos",
    "windows"
  ],
  "author": "Rintu KT",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
