{
  "manifest_version": 3,
  "name": "AquaBuddy - Water Drink Reminder",
  "version": "1.0.0",
  "description": "An adorable animated buddy that slides from your screen to remind you to drink water with interactive snooze and tracking.",
  "permissions": [
    "alarms",
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AquaBuddy Water Reminder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "assets/three.min.js",
        "assets/aquabuddy_3d_character.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "sounds/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
